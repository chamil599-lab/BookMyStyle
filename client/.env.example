# Used by the Vite dev server only (proxy target)
VITE_LARAVEL_URL=https://bookmystyle.test

# In production, leave VITE_API_BASE_URL as /api so the React app calls the
# same domain (Laravel served from the same cPanel document root).
VITE_API_BASE_URL=/api

# Used by SEO component for canonical/og:url. Must match the live domain.
VITE_SITE_URL=https://bookmystyle.limach.lk

# Public client IDs/keys (safe in browser bundle — restrict via console)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
