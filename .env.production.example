APP_NAME='BookMyStyle'
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bookmystyle.limach.lk
ASSET_URL=https://bookmystyle.limach.lk
TRUSTED_PROXIES=

CORS_ALLOWED_ORIGINS=https://bookmystyle.limach.lk
SANCTUM_STATEFUL_DOMAINS=bookmystyle.limach.lk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Colombo

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL credentials provided by cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Production SMTP (replace with your cPanel mail credentials)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_TIMEOUT=15
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@bookmystyle.limach.lk"
MAIL_FROM_NAME="BookMyStyle"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OAuth — replace with production credentials and update authorized redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enable operations after migrations, cron, queue and mail delivery are verified.
FEATURED_CLEANUP_ENABLED=false
SUBSCRIPTION_REMINDERS_ENABLED=false
BOOKING_REMINDERS_ENABLED=false

# Firebase service-account JSON must remain outside the public document root.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

SANCTUM_TOKEN_TTL_MINUTES=1440
